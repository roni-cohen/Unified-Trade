rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the request authenticated?
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: does this doc belong to the requester?
    function isOwner(resource) {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Helper: is the incoming doc being created by the requester?
    function isOwnerOnCreate() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /portfolios/{portfolioId} {
      allow read, update, delete: if isOwner(resource);
      allow create: if isOwnerOnCreate();
    }

    match /positions/{positionId} {
      allow read, update, delete: if isOwner(resource);
      allow create: if isOwnerOnCreate();
    }

    match /journal/{entryId} {
      allow read, update, delete: if isOwner(resource);
      allow create: if isOwnerOnCreate();
    }

    match /snapshots/{snapshotId} {
      allow read, update, delete: if isOwner(resource);
      allow create: if isOwnerOnCreate();
    }
  }
}